+        campaignId,
+        outcomeKey: rule.outcomeKey,
+        sourceGroupId: rule.sourceGroupId,
+        sourceGroupName: rule.sourceGroupName,
+        bandIndex: evidence.bandIndex,
+        sourcePath: evidence.sourcePath,
+        resolvedBy: evidence.resolvedBy,
